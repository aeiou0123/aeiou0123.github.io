---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if page.lang == 'zh' %}
        <span class="font-weight-bold">魏</span>孟祺
      {% elsif site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        {% if page.lang == 'zh' %}
          最新动态
        {% else %}
          <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
        {% endif %}
      </h2>
      {% if page.lang == 'zh' %}
        <div class="news"><div class="table-responsive"><table class="table table-sm table-borderless">
<tr><th scope="row">2026年10月20日</th><td>获得国家奖学金。</td></tr>
<tr><th scope="row">2026年</th><td><a href="https://github.com/aeiou0123/pku-financial-ai-agent">Claim2Value</a> 项目进入北大金融 AI 智能体大赛复赛。</td></tr>
<tr><th scope="row">2026年9月</th><td>完成兴业研究宏观市场部实习。</td></tr>
<tr><th scope="row">2026年7月4日</th><td>完成本科二年级学业，专业排名第一（1 / 22，均分 90.73）。</td></tr>
</table></div></div>
      {% else %}
        <div class="news"><div class="table-responsive"><table class="table table-sm table-borderless">
<tr><th scope="row">Oct 20, 2026</th><td>Received the National Scholarship.</td></tr>
<tr><th scope="row">2026</th><td>Advanced to the semifinal round of the PKU Financial AI Agent Competition with <a href="https://github.com/aeiou0123/pku-financial-ai-agent">Claim2Value</a>.</td></tr>
<tr><th scope="row">Sep 15, 2026</th><td>Completed a macroeconomic research internship at CIB Research.</td></tr>
<tr><th scope="row">Jul 4, 2026</th><td>Completed sophomore year ranked first in the cohort (90.73/100).</td></tr>
</table></div></div>
      {% endif %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        {% if page.lang == 'zh' %}
          <a href="{{ '/zh/research/' | relative_url }}" style="color: inherit">代表性研究与项目</a>
        {% else %}
          <a href="{{ '/research/' | relative_url }}" style="color: inherit">selected publications</a>
        {% endif %}
      </h2>
      {% if page.lang == 'zh' %}
        <div class="publications">
          <ol class="bibliography">
            <li class="mb-4">
              <div class="row">
                <div class="col-sm-2 abbr">
                  <abbr class="badge">工作论文</abbr>
                </div>
                <div class="col-sm-10">
                  <div class="title font-weight-bold">大语言模型冲击下高校本科专业结构的适应性调整——理论建模、LLM 暴露度测度与连续双重差分实证</div>
                  <div class="author">魏孟祺；指导教师：陈晓东、杨晓亮</div>
                  <div class="periodical"><em>在研工作论文 / 科研训练，西安交通大学金禾经济研究中心</em>, 2026</div>
                  <div class="abstract-content text-muted mt-2" style="font-size: 0.92rem; line-height: 1.6;">
                    研究大语言模型的发展与高校专业供给之间的关系，项目正在进行中。
                  </div>
                </div>
              </div>
            </li>
            <li class="mb-4">
              <div class="row">
                <div class="col-sm-2 abbr">
                  <abbr class="badge">竞赛项目</abbr>
                </div>
                <div class="col-sm-10">
                  <div class="title font-weight-bold">Claim2Value：具身智能产业链技术声明核验与动态估值智能体</div>
                  <div class="author">魏孟祺 及团队</div>
                  <div class="periodical"><em>北大金融 AI 智能体大赛（进入复赛）</em>, 2026</div>
                  <div class="links mt-1">
                    <a href="https://github.com/aeiou0123/pku-financial-ai-agent" class="btn btn-sm btn-outline-primary py-0 px-2" role="button" target="_blank"><i class="fa-brands fa-github"></i> 代码仓库</a>
                  </div>
                  <div class="abstract-content text-muted mt-2" style="font-size: 0.92rem; line-height: 1.6;">
                    面向具身智能产业链，探索技术声明核验与企业估值。
                  </div>
                </div>
              </div>
            </li>
          </ol>
        </div>
      {% else %}
        {% include selected_papers.liquid %}
      {% endif %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>
